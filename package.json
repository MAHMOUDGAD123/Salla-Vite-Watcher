{
  "name": "theme-raed",
  "version": "1.0.3",
  "description": "Salla Theme",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SallaApp/theme-raed.git"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "watch": "cross-env NODE_NO_WARNINGS=1 ts-node ./plugins/fake-watcher.ts",
    "prod": "cross-env NODE_NO_WARNINGS=1 ts-node ./plugins/vite.prod.ts",
    "dev": "cross-env NODE_NO_WARNINGS=1 ts-node ./plugins/vite.dev.ts",
    "dev:debug": "cross-env NODE_NO_WARNINGS=1 NODE_ENV=debug ts-node ./plugins/vite.dev.ts",
    "dev:watch": "cross-env NODE_NO_WARNINGS=1 tsx watch ./plugins/vite.dev.ts",
    "dev:watch:debug": "cross-env NODE_NO_WARNINGS=1 NODE_ENV=debug tsx watch ./plugins/vite.dev.ts"
  },
  "author": "Salla",
  "dependencies": {
    "@salla.sa/twilight": "^2.14.170",
    "@salla.sa/twilight-tailwind-theme": "^2.14.170",
    "animejs": "^3.2.2",
    "fslightbox": "^3.6.2",
    "lite-youtube-embed": "^0.2.0",
    "mmenu-light": "^3.2.2",
    "sweetalert2": "^11.22.2"
  },
  "devDependencies": {
    "@salla.sa/twilight-components": "^2.14.170",
    "@tailwindcss/forms": "^0.5.10",
    "@types/postcss-import": "^14.0.3",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.4.21",
    "chokidar": "^4.0.3",
    "cross-env": "^7.0.3",
    "postcss": "^8.5.6",
    "postcss-import": "^15.1.0",
    "postcss-nesting": "^13.0.2",
    "postcss-preset-env": "^8.5.1",
    "sass": "^1.89.2",
    "tailwindcss": "^3.4.17",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "tsx": "^4.20.3",
    "vite": "^7.0.4",
    "ws": "^8.18.3"
  }
}
